# Copie este archivo como ".env" y ponga sus datos.
# El archivo .env NO se sube a GitHub.

# Conexión a PostgreSQL: postgres://usuario:contraseña@servidor:puerto/base
DATABASE_URL=postgres://postgres:SU_CONTRASEÑA@localhost:5432/hoteles_antigua

# true solo en Render (la base de internet necesita SSL)
DB_SSL=false

# Texto largo y secreto para firmar las sesiones (obligatorio en Render)
JWT_SECRET=cambie-este-texto-por-uno-largo-y-secreto

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# Opcional: contraseña del admin al ejecutar "npm run db:init".
# Si se pone, NO se crean los usuarios de prueba (registrador1..3, cliente1).
# ADMIN_PASSWORD=
