# Copia este archivo como .env y coloca tus datos de PostgreSQL
PORT=3000

# Conexión local (cambia TU_PASSWORD por la contraseña de tu usuario postgres)
DATABASE_URL=postgres://postgres:TU_PASSWORD@localhost:5432/hoteles_antigua

# En Render se usa la URL externa de la base de datos y SSL
# DATABASE_URL=postgres://usuario:password@host.render.com/base
# DB_SSL=true

# Clave para firmar los tokens de sesión (cámbiala por un texto largo y secreto)
JWT_SECRET=cambia-esta-clave-secreta
